{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./lib/*"],
      "@db/*": ["./db/*"]
    }
  },
  "include": ["server.ts", "lib/**/*.ts", "db/**/*.ts", "routes/**/*.ts", "server/**/*.ts"],
  "exclude": ["node_modules", "dist", ".next", "diagnostic-engine", "frontend"]
}
