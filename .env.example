# NeuroSync Environment Configuration

# API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_key_here
MISTRAL_API_KEY=your_mistral_key_here

# Database
DB_PATH=./neurosync.db
UPLOADS_DIR=./uploads

# ML Sidecar
ML_SIDECAR_URL=http://localhost:8000

# Authentication
SESSION_SECRET=your_session_secret_here_change_in_production
TOKEN_EXPIRY=604800000

# SMTP (Optional - for email reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@neurosync.app
ADMIN_REPORT_EMAIL=admin@neurosync.app

# Environment
NODE_ENV=development
PORT=3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
